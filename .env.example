DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres_pdf_explainer

LLM_PROVIDER=gemma_local
GEMMA_MODEL_ID=google/gemma-3-4b-it
GEMMA_MAX_NEW_TOKENS=750

# Remote Gemma (RunPod) configuration
GEMMA_REMOTE_URL=
GEMMA_REMOTE_API_KEY=
GEMMA_REMOTE_TIMEOUT_SECONDS=120

TTS_PROVIDER=mock
STT_PROVIDER=whisper
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3050
PDF_UPLOAD_DIR=backend/uploads
